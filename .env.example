# Copy to .env and adjust the values.
# Generate a new key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY='change-me'
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Optional – if not set, media/ and db.sqlite3 in the project folder are used
# DJANGO_MEDIA_ROOT=C:/path/to/media
# DJANGO_DB_PATH=C:/path/to/db.sqlite3
